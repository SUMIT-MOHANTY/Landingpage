{
  "name": "taskflow-frontend",
  "version": "1.0.0",
  "description": "TaskFlow Frontend Application",
  "scripts": {
    "start": "serve -s public",
    "optimize:images": "imagemin public/images/* --out-dir=public/images",
    "optimize:css": "csso public/css/main.css --output public/css/main.min.css",
    "optimize:js": "terser public/js/main.js -o public/js/main.min.js --compress --mangle",
    "build": "npm run optimize:css && npm run optimize:js && npm run optimize:images",
    "analyze": "lighthouse http://localhost:5000 --view"
  },
  "devDependencies": {
    "csso": "^5.0.5",
    "imagemin": "^8.0.1",
    "imagemin-cli": "^7.0.0",
    "lighthouse": "^9.6.8",
    "serve": "^14.2.0",
    "terser": "^5.16.6"
  }
}
